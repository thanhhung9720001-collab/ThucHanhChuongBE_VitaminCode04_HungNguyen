<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.vitamincode_pratice.mapper.RoleMapper">
    <resultMap id="Role" type="RoleEntity">
        <id column="id" property="id"/>
        <result column="role_name" property="role_name"/>
        <result column="description" property="description"/>

    </resultMap>
    <select id="selectAllRoles" resultMap="Role">
        SELECT
            r.id,
            r.role_name,
            r.description
        FROM role r;
    </select>

    <select id="selectRoleByName" resultMap="Role">
        SELECT
            r.id,
            r.role_name,
            r.description,
            r.created_day,
            r.created_by,
            r.updated_day,
            r.updated_by
        FROM role r
        WHERE r.role_name LIKE CONCAT('%', #{roleName}, '%')
    </select>

    <insert id="insertRole" parameterType="org.example.vitamincode_pratice.entity.RoleEntity" useGeneratedKeys="true" keyProperty="id" >
        INSERT INTO role(role_name, description)
        VALUES (#{role_name}, #{description})
    </insert>
    
    <update id="updateRole">
        UPDATE role SET role_name = #{role_name} , description = #{description}
        WHERE id = #{id};
    </update>
    
    <delete id="deleteRole">
        DELETE
        FROM role
        WHERE id = #{id};
    </delete>
</mapper>